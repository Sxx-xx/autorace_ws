<?xml version="1.0"?>
<model>
  <name>autorace_topcam</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <description>Debug camera 5 m above the course looking straight down. The
  image is 800x800 over 5 m, so world X maps to image up and world Y to image
  left: px = 400 - Y/0.00625, py = 400 - X/0.00625.</description>
</model>
