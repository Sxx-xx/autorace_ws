<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="autorace_topcam">
    <static>true</static>
    <link name="link">
      <!-- 5 m above the origin, looking straight down, x of the image along world +x -->
      <pose>0 0 5 0 1.5708 0</pose>
      <sensor name="topcam" type="camera">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>topcam/image_raw</topic>
        <camera name="topcam">
          <camera_info_topic>topcam/camera_info</camera_info_topic>
          <!-- 2*atan(2.5/5): covers 5 m across at ground level -->
          <horizontal_fov>0.9273</horizontal_fov>
          <image><width>800</width><height>800</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>20</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
