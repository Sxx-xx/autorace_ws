<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="autorace_level_bar">
    <link name="post">
      <pose>-0.16 0 0.11 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.03 0.03 0.22</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.03 0.03 0.22</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="post_fixed" type="fixed">
      <parent>world</parent>
      <child>post</child>
    </joint>

    <link name="bar">
      <!-- Link origin sits on the hinge; the bar itself extends towards +x. -->
      <pose>-0.16 0 0.2 0 0 0</pose>
      <inertial>
        <pose>0.15 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-3</iyy><izz>1e-3</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0.15 0 0 0 0 0</pose>
        <geometry><box><size>0.3 0.02 0.05</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0.15 0 0 0 0 0</pose>
        <geometry><box><size>0.3 0.02 0.05</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://autorace_level_bar/materials/textures/traffic_bar.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.9</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <joint name="bar_joint" type="revolute">
      <parent>post</parent>
      <child>bar</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit><lower>0.0</lower><upper>1.5708</upper>
          <effort>10</effort><velocity>2.0</velocity></limit>
        <dynamics><damping>0.2</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>bar_joint</joint_name>
      <topic>/level_bar/cmd</topic>
      <p_gain>5.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>
  </model>
</sdf>
